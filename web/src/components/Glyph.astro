---
// Lumi-owned 20-unit glyph boundary. Product glyphs are drawn for this surface;
// ordinary geometric actions stay familiar. No third-party icon runtime.
interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: className } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M4 10h12M11 5l5 5-5 5"/>',
  external: '<path d="M11 3h6v6M17 3l-9 9M8 4H4a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4"/>',
  chevron: '<path d="m6 8 4 4 4-4"/>',
  menu: '<path d="M3 6h14M3 10h14M3 14h14"/>',
  folder: '<path d="M3 5h5l2 2h7v10H3zM3 5V3h5l2 2h7v2"/>',
  file: '<path d="M4 2h8l4 4v12H4zM12 2v5h4M7 11h6M7 14h4"/>',
  check: '<path d="m4 10 4 4 8-8"/>',
  evidence: '<path d="M3 3h10v14H3zM6 7h4M6 10h4M6 13h2M13 7h4v10h-4"/><circle cx="16" cy="3" r="1" fill="currentColor" stroke="none"/>',
  shield: '<path d="m10 2 7 3v5c0 4-7 8-7 8S3 14 3 10V5zM6.5 9.5l2.5 2.5 4.5-4.5"/>',
  workflow: '<path d="M3 3h5v5H3zM12 12h5v5h-5zM8 5h6v4M6 12v3h6"/>',
  clock: '<circle cx="10" cy="10" r="7"/><path d="M10 6v4l3 2"/>',
  terminal: '<path d="M2 4h16v12H2zM5 7l3 3-3 3M10 13h4"/>',
  browser: '<path d="M2 3h16v14H2zM2 7h16M5 5h.01M8 5h.01"/>',
  lock: '<rect x="4" y="8" width="12" height="10" rx="1"/><path d="M6 8V6a4 4 0 0 1 8 0v2M10 12v2"/>',
  branch: '<circle cx="5" cy="4" r="2"/><circle cx="5" cy="16" r="2"/><circle cx="15" cy="4" r="2"/><path d="M5 6v8M15 6v2c0 3-10 1-10 5"/>',
  download: '<path d="M10 2v10M6 8l4 4 4-4M3 13v4h14v-4"/>',
  plus: '<path d="M10 4v12M4 10h12"/>',
  github: '<path d="M7 17c-4 1-4-2-5-2m10 4v-3.5c0-1 .1-1.4-.5-2 3.5-.4 5.5-1.7 5.5-5a4 4 0 0 0-1-3c.1-.4.5-2-0.2-3 0 0-1-.3-3.3 1a11 11 0 0 0-6 0C4.2 2.2 3.2 2.5 3.2 2.5c-.7 1-.3 2.6-.2 3a4 4 0 0 0-1 3c0 3.3 2 4.6 5.5 5-.6.6-.6 1.2-.5 2V19"/>',
};
if (!paths[name]) throw new Error(`Unknown Lumi glyph: ${name}`);
---
<svg class={className} width={size} height={size} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
