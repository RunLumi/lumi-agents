---
import Page from '../layouts/Page.astro';
import Brand from '../components/Brand.astro';
import Glyph from '../components/Glyph.astro';
import WorkDemo from '../components/WorkDemo.astro';
import ProductFacts from '../components/ProductFacts.astro';
import { site, faqs } from '../data/site.mjs';
const docs = `${site.repository}/blob/main/docs`;
const nav = [['#san-pham', 'Sản phẩm'], ['#cach-hoat-dong', 'Cách hoạt động'], ['#nguyen-tac', 'Nguyên tắc'], ['#cau-hoi', 'Câu hỏi']];
---
<Page includeFaq>
  <a class="skip-link" href="#noi-dung">Bỏ qua điều hướng</a>
  <header class="site-header">
    <div class="header-inner wrap">
      <a class="brand-link" href="/" aria-label="Lumi Agents — Trang chủ"><Brand /></a>
      <nav class="desktop-nav" aria-label="Điều hướng chính">{nav.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
      <div class="header-actions"><a class="repo-link" href={site.repository} aria-label="Mã nguồn Lumi Agents trên GitHub"><Glyph name="github" /><span>GitHub</span></a><a class="button button-primary button-small" href={site.contact}>Trao đổi dùng thử <Glyph name="arrow" size={16} /></a></div>
      <details class="mobile-nav"><summary aria-label="Mở menu điều hướng"><Glyph name="menu" /><span>Menu</span></summary><nav aria-label="Điều hướng trên điện thoại">{nav.map(([href, label]) => <a href={href}>{label}</a>)}<a href={site.repository}>Mã nguồn GitHub <Glyph name="external" size={16} /></a><a href={site.contact}>Trao đổi dùng thử <Glyph name="arrow" size={16} /></a></nav></details>
    </div>
  </header>
  <main id="noi-dung">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-overline"><a class="release-pill" href={`${docs}/v1-readiness.md`}><span class="annotation-dot" aria-hidden="true"></span> Đang xây dựng công khai <Glyph name="arrow" size={14} /></a><span class="hero-edition">Không gian làm việc cùng AI</span></div>
      <div class="hero-heading">
        <h1 id="hero-title">Giao việc cho AI.<br /><span>Giữ quyền làm chủ.</span></h1>
        <div class="hero-intro"><p>Một nơi để AI làm việc với tệp, trình duyệt và ứng dụng của bạn. Có đầu ra để kiểm tra. Có giới hạn rõ ràng. Có bạn ở những quyết định quan trọng.</p><div class="hero-actions"><a class="button button-primary" href={site.contact}>Trao đổi dùng thử <Glyph name="arrow" /></a><a class="text-link" href="#san-pham">Khám phá cách làm <span aria-hidden="true">↘</span></a></div><p class="hero-status">Bản xem trước · Chưa phát hành v1</p></div>
      </div>
      <WorkDemo />
      <div class="design-principles" aria-label="Nguyên tắc thiết kế"><span class="principles-label">Được thiết kế để</span><span><Glyph name="folder" size={17} /> Giữ đúng phạm vi</span><span><Glyph name="shield" size={17} /> Tôn trọng quyền quyết định</span><span><Glyph name="evidence" size={17} /> Để lại kết quả có thể kiểm tra</span></div>
    </section>

    <section class="journey-section section wrap" id="cach-hoat-dong" aria-labelledby="journey-title">
      <div class="section-heading"><div><p class="eyebrow">01 / Cách làm việc</p><h2 id="journey-title">Bắt đầu bằng một việc.<br />Không phải một hệ thống mới.</h2></div><p class="section-intro">Bạn biết điều cần đạt được. Lumi đang xây dựng phần còn lại: một luồng giao việc rõ ràng, từ ngữ cảnh đến kết quả.</p></div>
      <div class="journey-grid">
        <article><div class="journey-number"><span>01</span><div></div><Glyph name="folder" /></div><h3>Chọn nơi làm việc.</h3><p>Một thư mục, một dự án, một phạm vi. Giữ tệp và hướng dẫn ở nơi bạn đã quen sử dụng.</p><span class="journey-detail">Ngữ cảnh rõ từ đầu</span></article>
        <article><div class="journey-number"><span>02</span><div></div><Glyph name="workflow" /></div><h3>Giao một kết quả.</h3><p>Nói điều cần hoàn thành, điều không được làm và khi nào cần hỏi lại. Không phải chỉ dẫn từng cú nhấp.</p><span class="journey-detail">Mục tiêu thay cho thao tác</span></article>
        <article><div class="journey-number"><span>03</span><div></div><Glyph name="evidence" /></div><h3>Kiểm tra. Rồi quyết định.</h3><p>Nhận tệp kết quả, nguồn tham chiếu và ngoại lệ. Điều chưa chắc phải được chỉ ra, không giấu trong một câu trả lời hay.</p><span class="journey-detail">Bằng chứng thay cho lời hứa</span></article>
      </div>
    </section>

    <section class="capabilities-section section wrap" aria-labelledby="capabilities-title">
      <div class="section-heading"><div><p class="eyebrow">02 / Không gian làm việc</p><h2 id="capabilities-title">Công việc ở đâu,<br />Lumi bắt đầu ở đó.</h2></div><p class="section-intro">Không tách công việc ra khỏi ngữ cảnh. Kiến trúc hướng tới việc kết nối tệp, công cụ và cách làm của bạn — trong cùng một dự án.</p></div>
      <div class="capability-grid">
        <article class="feature-card feature-project">
          <div class="feature-copy"><span class="feature-index">Dự án & tệp</span><h3>Cả dự án.<br />Không chỉ một đoạn chat.</h3><p>Tệp nguồn, hướng dẫn và kết quả cùng một chỗ. Mở lại dự án để tiếp tục công việc, thay vì giải thích lại từ đầu.</p></div>
          <div class="folder-illustration" aria-label="Cấu trúc thư mục dự án minh họa"><div class="folder-root"><Glyph name="folder" /><span>du-an-cua-ban/</span><span class="scope-tag">Phạm vi</span></div><div class="file-tree"><div><Glyph name="folder" size={16} /><span>nguon/</span><span>Tệp đầu vào</span></div><div><Glyph name="file" size={16} /><span>AGENTS.md</span><span>Hướng dẫn</span></div><div><Glyph name="folder" size={16} /><span>.lumi/skills/</span><span>Cách làm</span></div><div class="tree-output"><Glyph name="folder" size={16} /><span>ket-qua/</span><span>Đầu ra của bạn</span></div></div><div class="folder-boundary"><Glyph name="lock" size={14} /> Mở thư mục không cấp quyền cho cả máy.</div></div>
        </article>
        <article class="feature-card feature-tools">
          <div class="feature-copy"><span class="feature-index">Công cụ & thực thi</span><h3>Mỗi việc,<br />một cách làm phù hợp.</h3><p>Ưu tiên kết nối có cấu trúc. Dùng trình duyệt và ứng dụng khi công việc cần đến chúng, không mặc định điều khiển màn hình.</p></div>
          <div class="execution-stack" aria-label="Thứ tự ưu tiên thực thi"><div><span class="tool-glyph"><Glyph name="terminal" /></span><span><strong>API & kết nối</strong><small>Ưu tiên dữ liệu có cấu trúc</small></span><span class="stack-order">01</span></div><div><span class="tool-glyph"><Glyph name="browser" /></span><span><strong>Trình duyệt</strong><small>Hiểu nút, biểu mẫu, nội dung</small></span><span class="stack-order">02</span></div><div><span class="tool-glyph"><Glyph name="workflow" /></span><span><strong>Ứng dụng desktop</strong><small>Trong quyền đã cho phép</small></span><span class="stack-order">03</span></div></div>
        </article>
        <article class="feature-card feature-routine">
          <div class="feature-copy"><span class="feature-index">Skills & workflow</span><h3>Làm tốt một lần.<br />Xây cách làm cho lần sau.</h3><p>Hướng dẫn có thể tái sử dụng. Workflow có phiên bản. Lịch chạy vẫn phải đi qua cùng một ranh giới quyền hạn.</p></div>
          <div class="routine-sheet"><div class="routine-heading"><Glyph name="clock" /><span>Rà soát đầu ngày</span><span class="mini-label">Minh họa</span></div><div class="week-strip" aria-label="Lịch mẫu thứ Hai đến thứ Sáu"><span class="selected">T2</span><span class="selected">T3</span><span class="selected">T4</span><span class="selected">T5</span><span class="selected">T6</span><span>T7</span><span>CN</span></div><div class="routine-bottom"><span>08:30 <span class="muted">· Asia/Ho_Chi_Minh</span></span><Glyph name="shield" size={16} /></div></div>
        </article>
        <article class="feature-card feature-model">
          <div class="feature-copy"><span class="feature-index">Mô hình & quyền lựa chọn</span><h3>Mô hình có thể thay đổi.<br />Cách giao việc thì không cần.</h3><p>Adapter tách nhà cung cấp khỏi workflow. Chọn theo khả năng, chi phí và giới hạn dữ liệu — không chỉ theo tên mô hình.</p></div>
          <div class="model-route"><div class="route-input"><Glyph name="folder" size={18} /><span>Dự án của bạn</span></div><div class="route-policy"><Glyph name="shield" size={18} /><span>Chính sách dữ liệu</span></div><div class="route-options"><span>Mô hình đám mây</span><span>Mô hình cục bộ</span></div></div><p class="feature-footnote">Khả năng thực tế phụ thuộc adapter và bản dựng. Local-first không đồng nghĩa mọi dữ liệu luôn ở trên máy.</p>
        </article>
      </div>
    </section>

    <section class="trust-section" id="nguyen-tac" aria-labelledby="trust-title"><div class="section wrap trust-grid">
      <div class="trust-copy"><p class="eyebrow">03 / Quyền làm chủ</p><h2 id="trust-title">AI đề xuất.<br /><span>Bạn quyết định.</span></h2><p class="trust-intro">Năng lực của AI không nên là lý do để bạn mất quyền kiểm soát. Đó là điểm xuất phát của Lumi, không phải một cài đặt bổ sung.</p><div class="trust-rules"><article><Glyph name="folder" /><div><h3>Phạm vi rõ ràng</h3><p>Chỉ những tệp, tài khoản và tác động được cho phép. Plugin hay mô hình không tự cấp thêm quyền.</p></div></article><article><Glyph name="shield" /><div><h3>Duyệt điều quan trọng</h3><p>Gửi ra ngoài, chi tiền, xóa dữ liệu hay đổi quyền phải qua chính sách và phê duyệt phù hợp.</p></div></article><article><Glyph name="evidence" /><div><h3>Không gọi mơ hồ là hoàn thành</h3><p>Kết quả cần được kiểm tra. Có thể là đã xong, bị chặn hoặc cần bạn xử lý — và phải nói rõ.</p></div></article></div></div>
      <div class="trust-visual"><div class="approval-sheet"><div class="approval-top"><span class="approval-icon"><Glyph name="shield" size={22} /></span><span class="attention-label">Cần bạn quyết định</span><span class="mini-label">Minh họa</span></div><h3>Bản nháp đã sẵn sàng.<br />Email chưa được gửi.</h3><p>Tạo nội dung và gửi nội dung là hai tác động khác nhau.</p><dl class="approval-facts"><div><dt>Tác động</dt><dd>Gửi báo cáo ra ngoài</dd></div><div><dt>Người nhận mẫu</dt><dd>client@example.com</dd></div><div><dt>Phạm vi</dt><dd>Một email · một bản nháp</dd></div><div><dt>Trạng thái</dt><dd><span class="attention-label">Chờ người phụ trách</span></dd></div></dl><div class="approval-bottom"><Glyph name="lock" size={16} /><span>Chưa có phê duyệt, chưa thực hiện.</span></div></div><div class="evidence-caption"><span class="caption-line" aria-hidden="true"></span><p>Quyền hạn không nằm trong lời nhắc.<br />Nó phải được thực thi bởi hệ thống.</p></div><p class="trust-disclosure">Đây là các nguyên tắc và hợp đồng thiết kế. Chúng không thay thế kiểm chứng bảo mật hoặc độ tin cậy của từng workflow. <a href={`${docs}/v1-readiness.md`}>Xem trạng thái thực tế <span aria-hidden="true">↗</span></a></p></div>
    </div></section>

    <section class="open-section section wrap" aria-labelledby="open-title"><div class="open-mark" aria-hidden="true"><Glyph name="branch" size={30} /></div><div class="open-copy"><p class="eyebrow">Xây dựng công khai / Apache-2.0</p><h2 id="open-title">Niềm tin cần nhiều hơn<br />một trang giới thiệu đẹp.</h2><p>Vì vậy, hãy xem cả mã nguồn, quyết định kiến trúc và những phần chưa hoàn thiện. Lumi đang phát triển cùng những người muốn giao việc cho AI một cách có trách nhiệm.</p><div class="open-links"><a class="button button-secondary" href={site.repository}><Glyph name="github" size={18} /> Khám phá mã nguồn <Glyph name="external" size={16} /></a><a class="text-link" href={`${docs}/roadmap.md`}>Xem hướng phát triển <Glyph name="arrow" size={16} /></a></div></div><aside class="readiness-note"><span class="annotation-dot" aria-hidden="true"></span><h3>Tiến bộ thật.<br />Giới hạn thật.</h3><p>Chưa phát hành v1. Chưa sẵn sàng cho vận hành khách hàng không giám sát. Các ví dụ trên trang là minh họa, không phải bằng chứng độ tin cậy sản xuất.</p><a href={`${docs}/implementation-truth.md`}>Điều gì đã có, điều gì chưa? <Glyph name="arrow" size={15} /></a></aside></section>

    <ProductFacts />

    <section class="faq-section section wrap" id="cau-hoi" aria-labelledby="faq-title"><div class="faq-heading"><p class="eyebrow">04 / Trước khi bắt đầu</p><h2 id="faq-title">Những điều<br />nên hỏi rõ.</h2><p>Một sản phẩm đáng tin cần nói rõ cả điều có thể làm và điều chưa thể hứa.</p></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<Glyph name="plus" size={20} /></summary><p>{answer}</p></details>)}</div></section>

    <section class="contact-section wrap" id="bat-dau" aria-labelledby="contact-title"><div class="contact-corner" aria-hidden="true"></div><p class="eyebrow">Bắt đầu nhỏ. Kiểm chứng thật.</p><h2 id="contact-title">Bạn có một việc<br />đang ngốn quá nhiều thời gian?</h2><p>Hãy bắt đầu từ đó. Một workflow cụ thể, một đầu ra rõ ràng,<br class="desktop-break" /> một thử nghiệm có giám sát — trước khi nghĩ đến tự động hóa mọi thứ.</p><a class="button button-primary" href={site.contact}>Trao đổi về workflow của bạn <Glyph name="arrow" /></a><span class="contact-note">Mở email gửi tới hello@runlumi.app. Không đăng ký tự động.</span></section>
  </main>
  <footer class="site-footer wrap"><div class="footer-top"><a class="brand-link" href="/" aria-label="Lumi Agents — Trang chủ"><Brand compact /></a><p>Bớt việc lặp lại. Thêm chỗ cho điều quan trọng.</p><nav aria-label="Liên kết cuối trang"><a href={site.repository}>GitHub</a><a href={`${site.repository}/blob/main/SECURITY.md`}>Bảo mật</a><a href={`${docs}/v1-readiness.md`}>Trạng thái</a><a href={site.contact}>Liên hệ</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} RunLumi. Lumi Agents.</span><span>Được xây dựng công khai, với sự cẩn trọng.</span><a href="#noi-dung">Về đầu trang <span aria-hidden="true">↑</span></a></div></footer>
  <script src="../scripts/landing.js"></script>
</Page>
