{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lumi Agents",
  "version": "0.1.0",
  "identifier": "test.runlumi.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Lumi Agents",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/lumi-icon-foreground.png",
      "icons/lumi-development.png",
      "icons/lumi-development.ico"
    ],
    "license": "Apache-2.0",
    "resources": {
      "../../../LICENSE": "legal/LICENSE.txt",
      "../../../NOTICE": "legal/NOTICE.txt",
      "../../../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_NOTICES.md": "legal/DESKTOP_THIRD_PARTY_NOTICES.md"
    }
  }
}
